  m_Script: {fileID: 11500000, guid: 5c20aad6a4f4c004b8bbb1c97e42e467, type: 3}
  m_Name: Crash
  m_EditorClassIdentifier: 
  lines:
  - speaker: Shirley
    text: Wow! That was really unlucky. Do you think that was on purpose?
  - speaker: You
    text: I sure hope not. Let's try to rebuild our ship.
  - speaker: Shirley
    text: Right.
  - speaker: Shirley
    text: Oh no.
  - speaker: You
    text: What's wrong?
  - speaker: Shirley
    text: I can't find our rockets anywhere.
  - speaker: You
    text: i can't find them either. Do you think they were stolen?
  - speaker: Shirley
    text: Surely not.
  - speaker: You
    text: Hmm.
  - speaker: Shirley
    text: Hmm.
